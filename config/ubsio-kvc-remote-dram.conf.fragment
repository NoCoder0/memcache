# Remote DRAM startup settings. Merge into the existing mmc-local.conf,
# together with the verified complete UBS-IO client configuration;
# this fragment does not replace network, ZooKeeper, CM, port or capacity settings.
# The four remote hosts and CM initial node count are different: D CM has five nodes.
ock.mmc.local_service.storage.enabled = true
ock.mmc.local_service.storage.mode = remote_dram
ubsio.kvc.mode = remote_dram_tcp
ubsio.kvc.tenant_id = 71
ubsio.kvc.remote_ips = 10.1.101.177,10.1.101.178,10.1.101.27,10.1.101.32
ubsio.kvc.read_workers = 4
ubsio.kvc.manifest_one_get = false
ubsio.net.data.protocol = tcp
ubsio.work.net.timeout = 300
ubsio.net.tls.enable.switch = true
# Replace these paths with readable, verified files for this client host.
ubsio.net.tls.ca.cert.path = /task-root/kunpeng-dram-V2/tls/ca.crt
ubsio.net.tls.server.cert.path = /task-root/kunpeng-dram-V2/tls/a3_10.1.101.22.crt
ubsio.net.tls.server.key.path = /task-root/kunpeng-dram-V2/tls/a3_10.1.101.22.key
